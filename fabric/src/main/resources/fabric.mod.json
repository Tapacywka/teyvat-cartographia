{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://modrinth.com/project/teyvat-cartographia",
    "sources": "https://github.com/Tapacywka/teyvat-cartographia",
    "issues": "https://github.com/Tapacywka/teyvat-cartographia/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "client": ["net.tapacywka.teyvatcartographia.fabric.TeyvatCartographiaFabric"],
    "modmenu": ["net.tapacywka.teyvatcartographia.fabric.ModMenuScreen"]
  },
  "mixins": ["teyvatcartographia.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version_range}",
    "fabric-api": "*",
    "aacs": ">=1.3.2",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
