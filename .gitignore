# Only the mod itself is versioned: sources, Gradle build files, licence, readme, changelog and the GitHub
# files (issue forms, README images).
# Everything else in this folder (test modpacks, backups, docs, tools, references, release files) stays local.
/*
!/.gitignore
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/common/
!/fabric/
!/neoforge/
!/LICENSE
!/README.md
!/CHANGELOG.md
!/.github/

# In-game development tests: local only (devtest-*.gradle and the devtest packages).
/common/src/main/java/net/tapacywka/teyvatcartographia/devtest/
/fabric/src/main/java/net/tapacywka/teyvatcartographia/devtest/
/neoforge/src/main/java/net/tapacywka/teyvatcartographia/devtest/
# The development games of each loader's build (run/ at the top stays ignored by the first rule).
/fabric/run*/
/neoforge/run*/

# Build output and IDE files, wherever they appear.
.gradle/
build/
out/
*.iml
.idea/
